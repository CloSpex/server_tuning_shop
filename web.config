<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <!-- Remove WebDAVModule, which often blocks POST/PUT/DELETE verbs on IIS -->
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <!-- Ensure the ExtensionlessUrlHandler allows ALL verbs (*) to pass to the ASP.NET Core Module -->
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" 
           path="*." 
           verb="*" 
           type="System.Web.Handlers.TransferRequestHandler" 
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    
    <!-- Optional: Ensures your application starts correctly (adjust .dll name if necessary) -->
    <aspNetCore processPath="dotnet" 
                arguments=".\server.dll" 
                stdoutLogEnabled="false" 
                stdoutLogFile=".\logs\stdout" 
                hostingModel="InProcess" />
  </system.webServer>
</configuration>